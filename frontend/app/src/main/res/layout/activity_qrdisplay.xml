<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundGray">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merchant QR Code"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"/>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Top Gradient Background -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/header_gradient" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:gravity="center_horizontal">

            <!-- Merchant Info Header -->
            <TextView
                android:id="@+id/merchantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop Name"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/merchantUpi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="upi@id"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif"/>

            <!-- QR Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/qrCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/cardWhite">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan to Pay"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/textDark"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="sans-serif-medium"/>

                    <!-- Removed the green frame background -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="0dp">

                        <ImageView
                            android:id="@+id/qrImage"
                            android:layout_width="240dp"
                            android:layout_height="240dp"
                            android:scaleType="fitCenter"
                            tools:src="@drawable/ic_qr_placeholder" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="UpiMicroPay Secure Payment"
                        android:textColor="@color/textLight"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:fontFamily="sans-serif"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Container -->
            <LinearLayout
                android:id="@+id/actionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/amountQrButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Generate Amount QR"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    android:backgroundTint="@color/primaryGreen"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_qr_code"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/downloadButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Save"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_download"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="@color/textDark"
                        android:background="@color/cardWhite"
                        app:cornerRadius="12dp"
                        app:elevation="2dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shareButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Share"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_share"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="@color/textDark"
                        android:background="@color/cardWhite"
                        app:cornerRadius="12dp"
                        app:elevation="2dp"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customers can scan this code using any UPI app to pay you instantly."
                android:textColor="@color/textLight"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>